# Set these in Vercel: Project -> Settings -> Environment Variables (never commit real values).
ANTHROPIC_API_KEY=            # key from console.anthropic.com
TELEGRAM_BOT_TOKEN=           # token of the bot that will message you (for example the studio bot from @BotFather)
TELEGRAM_CHAT_ID=             # your numeric Telegram id (the bot can only write to people who pressed Start)
# ESTIMATE_MODEL=claude-haiku-4-5-20251001   # optional: another Claude model
