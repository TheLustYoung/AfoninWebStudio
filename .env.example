# Optional: without these the calculator still works, and the visitor sends the calculation to you through ready-made Telegram/WhatsApp links.
# Set them in Vercel (Project -> Settings -> Environment Variables, type Secret) to get requests straight into your Telegram.
TELEGRAM_BOT_TOKEN=           # token of the bot that will message you
TELEGRAM_CHAT_ID=             # your numeric Telegram id (press Start in that bot first)
